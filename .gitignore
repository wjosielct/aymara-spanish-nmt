# Python caches and packaging
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and secrets (keep environment.yml tracked)
.venv/
venv/
env/
ENV/
.conda/
.env
.env.*
!.env.example

# Notebook checkpoints, editors, and operating-system files
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp

# Source data: exclude all raw data except the licensed conversational PDF.
# Biblical source editions are not redistributed by this repository.
/data/raw/*
!/data/raw/book/
/data/raw/book/*
!/data/raw/book/book.pdf

# Generated corpora include source text even when tokenized.
/data/interim/
/data/clean/
/data/splits/
/data/tokenized/

# Model checkpoints.
/models/
*.pt
*.pth
*.ckpt
*.safetensors

# Track code, config.yaml, configs_generated/, results/, plots/,
# tokenizer/SentencePiece.model, tokenizer/SentencePiece.vocab, and the notebook.
# Before committing the notebook, remove any saved corpus-text previews.
# Ignore rules do not untrack files already committed to Git.
